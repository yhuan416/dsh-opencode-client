{
  "name": "dsh-opencode-client",
  "version": "1.1.3",
  "type": "module",
  "description": "DeepSeek Harness plugin that acts as an OpenCode client: list, read and continue remote OpenCode sessions, delegate work to them, and use OpenCode as a native subagent.",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhuan416/dsh-opencode-client.git"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "ARCHITECTURE.md",
    "COMPATIBILITY.md",
    "CHANGELOG.md",
    "docs",
    "scripts/check.mjs",
    "scripts/e2e-live.mjs"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "opencode",
    "subagent"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.mjs && node scripts/check-manifest.mjs && node --test",
    "e2e": "node scripts/e2e-live.mjs",
    "manifest": "node scripts/check-manifest.mjs",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@opencode/client": "2.4.2"
  }
}
