{
  "name": "dsh-opencode-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness plugin that acts as an OpenCode client: list, read and continue remote OpenCode sessions, delegate work to them, and use OpenCode as a native subagent.",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhuan416/dsh-opencode-client.git"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "ARCHITECTURE.md",
    "COMPATIBILITY.md",
    "CHANGELOG.md",
    "docs",
    "scripts/check.mjs"
  ],
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "check": "node scripts/check.mjs"
  }
}
